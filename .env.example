# Environment Variables — Copy to .env and fill in values

# Application
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string_minimum_32_chars
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./dr_screening.db

# Model paths (relative to project root)
CNN_CHECKPOINT=checkpoints/best_cnn_model.pth
MULTIMODAL_CHECKPOINT=checkpoints/best_multimodal_model.pth
FEDERATED_CHECKPOINT=checkpoints/federated_global_model.pth

# Data paths
DATA_DIR=data/retinal
EHR_DIR=data/ehr
UPLOAD_DIR=uploads/

# Kaggle API (for APTOS 2019 dataset download)
# Create at: https://www.kaggle.com/settings/account → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Device (auto | cpu | cuda)
DEVICE=auto

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/
